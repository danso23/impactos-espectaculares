{
  "name": "espectaculares-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently -n BACKEND,FRONTEND -c blue,green \"npm run backend\" \"npm run frontend\"",
    "backend": "cd espectacularesapi && php artisan serve --host=127.0.0.1 --port=8000",
    "frontend": "cd espectacularesweb && npm run vite:devlocal",
    "install:all": "npm install && cd espectacularesweb && npm install",
    "build:frontend": "cd espectacularesweb && npm run build",
    "preview:frontend": "cd espectacularesweb && npm run preview"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "lucide-react": "^0.562.0"
  }
}
